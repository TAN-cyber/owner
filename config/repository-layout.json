{
  "assetsRoot": "assets",
  "manifestPath": "assets/manifest.json",
  "skillsRoots": {
    "en": "assets/skills",
    "zh": "assets/skills-zh"
  },
  "pipelineRuntime": {
    "entries": {
      "runtime": "domains/owner-pipeline/pipeline-cli.ts",
      "state": "domains/owner-pipeline/pipeline-state-entry.ts",
      "validate": "domains/owner-pipeline/pipeline-validate-entry.ts",
      "guard": "domains/owner-pipeline/pipeline-guard-entry.ts",
      "handoff": "domains/owner-pipeline/pipeline-handoff-entry.ts",
      "archive": "domains/owner-pipeline/pipeline-archive-entry.ts",
      "hookGuard": "domains/owner-pipeline/pipeline-hook-guard-entry.ts",
      "intent": "domains/owner-pipeline/pipeline-intent-entry.ts",
      "resume-probe": "domains/owner-pipeline/pipeline-resume-probe-entry.ts"
    },
    "outputs": {
      "runtime": "assets/skills/owner/scripts/owner-runtime.mjs",
      "state": "assets/skills/owner/scripts/owner-state.mjs",
      "validate": "assets/skills/owner/scripts/owner-yaml-validate.mjs",
      "guard": "assets/skills/owner/scripts/owner-guard.mjs",
      "handoff": "assets/skills/owner/scripts/owner-handoff.mjs",
      "archive": "assets/skills/owner/scripts/owner-archive.mjs",
      "hookGuard": "assets/skills/owner/scripts/owner-hook-guard.mjs",
      "intent": "assets/skills/owner/scripts/owner-intent.mjs",
      "resume-probe": "assets/skills/owner/scripts/owner-resume-probe.mjs"
    }
  },
  "loopRuntime": {
    "entries": {
      "runtime": "domains/owner-loop/loop-cli-entry.ts",
      "hookGuard": "domains/owner-loop/loop-hook-guard-entry.ts",
      "init": "domains/owner-loop/loop-init-entry.ts",
      "root": "domains/owner-loop/loop-root-entry.ts",
      "new": "domains/owner-loop/loop-new-entry.ts",
      "spec": "domains/owner-loop/loop-spec-entry.ts",
      "show": "domains/owner-loop/loop-show-entry.ts",
      "status": "domains/owner-loop/loop-status-entry.ts",
      "select": "domains/owner-loop/loop-select-entry.ts",
      "next": "domains/owner-loop/loop-next-entry.ts",
      "archive": "domains/owner-loop/loop-archive-entry.ts",
      "doctor": "domains/owner-loop/loop-doctor-entry.ts"
    },
    "outputs": {
      "runtime": "assets/skills/owner-loop/scripts/owner-loop-runtime.mjs",
      "hookGuard": "assets/skills/owner-loop/scripts/owner-loop-hook-guard.mjs",
      "init": "assets/skills/owner-loop/scripts/owner-loop-init.mjs",
      "root": "assets/skills/owner-loop/scripts/owner-loop-root.mjs",
      "new": "assets/skills/owner-loop/scripts/owner-loop-new.mjs",
      "spec": "assets/skills/owner-loop/scripts/owner-loop-spec.mjs",
      "show": "assets/skills/owner-loop/scripts/owner-loop-show.mjs",
      "status": "assets/skills/owner-loop/scripts/owner-loop-status.mjs",
      "select": "assets/skills/owner-loop/scripts/owner-loop-select.mjs",
      "next": "assets/skills/owner-loop/scripts/owner-loop-next.mjs",
      "archive": "assets/skills/owner-loop/scripts/owner-loop-archive.mjs",
      "doctor": "assets/skills/owner-loop/scripts/owner-loop-doctor.mjs"
    }
  },
  "entryRuntime": {
    "entries": {
      "runtime": "domains/owner-entry/entry-runtime-entry.ts",
      "hookRouter": "domains/owner-entry/hook-router-entry.ts"
    },
    "outputs": {
      "runtime": "assets/skills/owner/scripts/owner-entry-runtime.mjs",
      "hookRouter": "assets/skills/owner/scripts/owner-hook-router.mjs"
    }
  },
  "allowedTopLevelEntries": [
    ".agents",
    ".claude",
    ".codex",
    ".owner",
    ".git",
    ".gitattributes",
    ".github",
    ".gitignore",
    ".gitmodules",
    ".husky",
    ".idea",
    ".npmignore",
    ".prettierignore",
    ".prettierrc",
    ".superpowers",
    ".tmp",
    "AGENTS.md",
    "app",
    "assets",
    "bin",
    "build.js",
    "CHANGELOG.md",
    "CLAUDE.md",
    "codecov.yml",
    "config",
    "CONTRIBUTING-zh.md",
    "CONTRIBUTING.md",
    "coverage",
    "dist",
    "docs",
    "domains",
    "eslint.config.js",
    "LICENSE",
    "NOTICE",
    "node_modules",
    "nul",
    "package-lock.json",
    "package.json",
    "platform",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "README-zh.md",
    "README.md",
    "scripts",
    "skills-lock.json",
    "test",
    "tsconfig.json",
    "vitest.config.ts"
  ],
  "sourceRoots": ["app", "domains", "platform"],
  "appModules": ["cli", "commands"],
  "domainModules": [
    "engine",
    "integrations",
    "owner-entry",
    "owner-loop",
    "owner-pipeline",
    "skill",
    "workflow-contract"
  ],
  "platformModules": ["fs", "install", "paths", "process", "version"],
  "scriptModules": ["build", "install", "lib", "lint", "release"],
  "allowedCodeFiles": ["bin/fast-runtime-router.js"],
  "testRoots": ["test"]
}
